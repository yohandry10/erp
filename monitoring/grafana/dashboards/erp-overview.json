{
  "title": "ERP Suite - Overview",
  "tags": [
    "erp",
    "overview"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Requests por Segundo",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(erp_http_requests_total[5m])",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia P95",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(erp_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de Errores",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(erp_http_request_errors_total[5m])",
          "legendFormat": "{{error_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uso de Memoria",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "Memoria (MB)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Órdenes de Compra Creadas",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(erp_ordenes_compra_creadas_total[1h]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Facturas Emitidas",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(erp_facturas_emitidas_total[1h]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pagos Registrados",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(erp_pagos_registrados_total[1h]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(erp_cache_hits_total[5m])) / (sum(rate(erp_cache_hits_total[5m])) + sum(rate(erp_cache_misses_total[5m])))"
        }
      ]
    }
  ],
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "uid": "erp-overview",
  "schemaVersion": 39,
  "version": 1
}
