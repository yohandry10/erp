{
  "name": "erp-suite",
  "version": "1.0.0",
  "description": "Sistema ERP completo con CPE, GRE, SIRE - Monorepo TypeScript",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "desktop:dev": "turbo run desktop:dev --filter=@erp-suite/web",
    "desktop:build": "turbo run desktop:build --filter=@erp-suite/web",
    "docker:build": "docker build -f apps/erp-api/Dockerfile -t ghcr.io/org/erp-api:latest .",
    "k8s:lint": "helm lint infra/helm/erp-suite",
    "k8s:deploy": "helm upgrade --install erp infra/helm/erp-suite",
    "test:quality": "node scripts/audit-test-quality.mjs",
    "check-encoding": "powershell -ExecutionPolicy Bypass -File ./scripts/check-encoding.ps1",
    "fix-encoding": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-encoding.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.9.12",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@swc/helpers": "^0.5.17",
    "next": "15.5.16"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.7.3",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "handlebars": "4.7.9",
      "jws": "3.2.3",
      "lodash": "4.18.1",
      "minimatch@<5": "3.1.4",
      "minimatch@>=5 <6": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "multer": "2.1.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "path-to-regexp@>=8 <8.4.0": "8.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.14",
      "qs": "6.15.1",
      "serialize-javascript": "7.0.3",
      "body-parser": "2.2.2",
      "ajv@<6.14.0": "6.15.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "js-yaml@<3.14.2": "3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": "4.1.1",
      "validator": "13.15.35"
    }
  }
}
