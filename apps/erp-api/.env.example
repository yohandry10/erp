# ==========================================================================
# ERP API - Variables de entorno (archivo de ejemplo)
# Entorno backend: apps/erp-api
# Plantilla documental. El runtime sólo carga .env.production; no use .env.local.
# ==========================================================================

# =============================================
# Entorno y runtime
# =============================================
NODE_ENV=production
DEPLOYMENT_ENV=PROD
EXPECTED_SUPABASE_PROJECT_REF=wypnbcptofqdmoynlonq
DEMO_API_ENABLED=false
PORT=3002
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# =============================================
# JWT / sesión / CSRF
# =============================================
JWT_SECRET=                  # obligatorio fuera de test
JWT_REFRESH_SECRET=         # obligatorio fuera de test
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=              # obligatorio fuera de test
CSRF_SECRET=                # obligatorio fuera de test
AUTH_SIGNATURE_SECRET=       # obligatorio fuera de test

# =============================================
# Cifrado
# =============================================
ENCRYPTION_KEY=
DB_ENCRYPTION_KEY=
CERT_ENCRYPTION_KEY=
CERT_ENCRYPTION_KEY_OLD=
# Certificado de firma global (fallback): se requiere definir ambos si se usa
PFX_PATH=
PFX_PASS=
CERTIFICATE_PASSWORD=
REQUIRE_REAL_FISCAL_CERTIFICATE=false

# =============================================
# Redis/cache distribuido
# En production, REDIS_REQUIRED debe ser true o NODE_ENV=production fallara si Redis no conecta.
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false

# =============================================
# Supabase
# =============================================
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================
# SUNAT/OSE/POS
# =============================================
SUNAT_API_KEY=
SUNAT_API_SECRET=
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_ENVIRONMENT=homologacion
SUNAT_AUTO_RETRY_ENABLED=true
SUNAT_CPE_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_GRE_URL=https://e-beta.sunat.gob.pe/ol-ti-itemision-guia-gem-beta/billService
SUNAT_GRE_TRANSPORT=soap
SUNAT_GRE_REST_BASE_URL=https://api-cpe.sunat.gob.pe/v1
SUNAT_GRE_AUTH_URL=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=
SUNAT_SUMMARY_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_QUERY_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
OSE_URL=
OSE_USERNAME=
OSE_USUARIO=
OSE_PASSWORD=
POS_WORKER_JWT_SECRET=
WORKER_API_JWT_SECRET=

# Confianza de autoridad para ApplicationResponse DIAN 02/04. La cadena y los
# pins pertenecen al firmante XML DIAN; son distintos del TLS y del PFX tenant.
DIAN_AUTHORITY_CA_BUNDLE_PEM=
DIAN_AUTHORITY_SPKI_SHA256=

# =============================================
# Límite de peticiones / seguridad runtime
# =============================================
THROTTLE_LIMIT=100
THROTTLE_TTL=60000
HEALTH_TOKEN=

# =============================================
# Supabase tunables (opcional)
# =============================================
SUPABASE_FETCH_TIMEOUT_MS=8000
SUPABASE_FETCH_MAX_RETRIES=2
SUPABASE_FETCH_RETRY_BASE_MS=250
SUPABASE_NETWORK_BACKOFF_MS=30000

# =============================================
# Hash
# =============================================
HASH_SALT_ROUNDS=12

# =============================================
# Flags funcionales
# =============================================
FEATURE_INVENTARIO_ENABLED=true
FEATURE_POS_ENABLED=true
FEATURE_RRHH_ENABLED=true
PLANILLA_OUTBOX_ENABLED=true
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_LEADER=false
BACKGROUND_JOBS_ASISTENCIAS_ENABLED=true
BACKGROUND_JOBS_INVENTARIO_ENABLED=true
METRICS_ENABLED=true
