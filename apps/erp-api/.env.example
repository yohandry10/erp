# Copia este archivo como `.env.local` antes de ejecutar la API.
# Reemplaza los valores de ejemplo con tus secretos reales.
PORT=
NODE_ENV=production
LOG_LEVEL=info
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
DB_ENCRYPTION_KEY=
SESSION_SECRET=
CSRF_SECRET=
HASH_SALT_ROUNDS=12
PFX_PATH=
PFX_PASS=
CERT_PATH=
CERTIFICATE_PATH=
CERTIFICATE_PASSWORD=
EMPRESA_RUC=
SUNAT_API_KEY=
SUNAT_API_SECRET=
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_ENVIRONMENT=sandbox
SUNAT_AUTO_RETRY_ENABLED=true
OSE_URL=
OSE_USERNAME=
OSE_PASSWORD=
POS_WORKER_JWT_SECRET=
FEATURE_INVENTARIO_ENABLED=true
FEATURE_POS_ENABLED=true
FEATURE_RRHH_ENABLED=true
PLANILLA_OUTBOX_ENABLED=true
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_LEADER=false
BACKGROUND_JOBS_ASISTENCIAS_ENABLED=true
BACKGROUND_JOBS_INVENTARIO_ENABLED=true
METRICS_ENABLED=true
HEALTH_TOKEN=
THROTTLE_LIMIT=100
THROTTLE_TTL=60