{
  "name": "@erp-suite/erp-api",
  "version": "1.0.0",
  "description": "Backend ERP Suite API (NestJS)",
  "main": "dist/erp-api/src/main.js",
  "scripts": {
    "dev": "dotenv -e .env -- nodemon --exec ts-node --transpile-only src/main.ts",
    "start": "node dist/erp-api/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:legacy": "ts-node --transpile-only tests/run-tests.ts",
    "presentar:asientos": "ts-node --transpile-only src/modules/contabilidad/scripts/presentar-asientos.ts",
    "clean": "rmdir /s /q dist 2>nul || echo Cleaned"
  },
  "dependencies": {
    "@erp-suite/crypto": "workspace:*",
    "@erp-suite/dtos": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/schedule": "^2.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^3.1.0",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/postgrest-js": "^1.19.4",
    "@supabase/supabase-js": "^2.50.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "xmlbuilder2": "3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/form-data": "^2.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
