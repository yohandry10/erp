{
  "name": "@erp-suite/erp-api",
  "version": "1.0.0",
  "description": "Backend ERP Suite API (NestJS)",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "dotenv -e .env -- nodemon --exec ts-node --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./jest-e2e.json",
    "test:e2e:production-readiness": "ts-node --transpile-only tests/e2e/production-readiness-e2e.test.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:legacy": "ts-node --transpile-only tests/run-tests.ts",
    "presentar:asientos": "ts-node --transpile-only src/modules/contabilidad/scripts/presentar-asientos.ts",
    "clean": "rmdir /s /q dist 2>nul || echo Cleaned"
  },
  "dependencies": {
    "@erp-suite/crypto": "workspace:*",
    "@erp-suite/dtos": "workspace:*",
    "@nestjs/common": "^11.1.20",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.20",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/postgrest-js": "^1.19.4",
    "@supabase/supabase-js": "^2.105.4",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.0.0",
    "uuid": "^11.1.1",
    "xmlbuilder2": "3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.20",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/form-data": "^2.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
