{
  "name": "@erp-suite/erp-api",
  "version": "1.0.0",
  "description": "Backend ERP Suite API (NestJS)",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "node -e \"throw new Error('Runtime local bloqueado: use build/start con .env.production; DEV está retirado')\"",
    "start": "node dist/src/main.js",
    "start:dev": "node -e \"throw new Error('Runtime local bloqueado: DEV está retirado')\"",
    "start:debug": "node -e \"throw new Error('Runtime debug bloqueado: DEV está retirado')\"",
    "build": "nest build",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./jest-e2e.json",
    "test:e2e:production-readiness": "ts-node --transpile-only tests/e2e/production-readiness-e2e.test.ts",
    "test:e2e:runtime-outbox-postgrest": "ts-node --transpile-only tests/e2e/runtime-outbox-postgrest-e2e.test.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:legacy": "ts-node --transpile-only tests/run-tests.ts",
    "presentar:asientos": "ts-node --transpile-only src/modules/contabilidad/scripts/presentar-asientos.ts",
    "sunat:readiness-preflight": "ts-node --transpile-only scripts/sunat-readiness-preflight.ts",
    "sunat:beta-smoke:ra-rc-gre": "ts-node --transpile-only scripts/sunat-beta-ra-rc-gre-smoke.ts",
    "sunat:beta-ticket-readonly": "ts-node --transpile-only scripts/sunat-beta-ticket-readonly.ts",
    "clean": "rmdir /s /q dist 2>nul || echo Cleaned"
  },
  "dependencies": {
    "@erp-suite/crypto": "workspace:*",
    "@erp-suite/dtos": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.50.0",
    "@supabase/postgrest-js": "^1.19.4",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "5.7.3",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.0.0",
    "uuid": "^11.1.1",
    "xmlbuilder2": "3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "8.34.0",
    "@typescript-eslint/parser": "8.34.0",
    "dotenv-cli": "^11.0.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
