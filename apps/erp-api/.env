# ============================================
# CERTIFICADO DIGITAL PARA FACTURACIÓN
# ============================================
# ⚠️ IMPORTANTE: Actualmente en MODO DEMO
# Para producción, necesitas configurar un certificado digital real
# Ver: CERTIFICADO_DIGITAL_SETUP.md

# Ruta al archivo PFX (dejar vacío para modo DEMO)
PFX_PATH=
# PFX_PATH=./certs/certificado.pfx

# Contraseña del certificado PFX
PFX_PASS=
# PFX_PASS=tu_contraseña_del_certificado

# Ruta alternativa para OSE
CERTIFICATE_PATH=
CERTIFICATE_PASSWORD=

# ============================================
# CONFIGURACIÓN SUNAT
# ============================================

# Ambiente: 'homologacion' o 'produccion'
SUNAT_ENVIRONMENT=homologacion

# RUC de la empresa
EMPRESA_RUC=20000000001

# Credenciales SUNAT SOL (para homologación usar MODDATOS/moddatos)
SUNAT_USERNAME=MODDATOS
SUNAT_PASSWORD=moddatos

# URL del OSE (Operador de Servicios Electrónicos)
# Homologación: https://api-cpe-beta.sunat.gob.pe
# Producción: https://api-cpe.sunat.gob.pe
OSE_URL=https://api-cpe-beta.sunat.gob.pe
OSE_USERNAME=MODDATOS
OSE_PASSWORD=moddatos

# ============================================
# REINTENTOS AUTOMÁTICOS SUNAT
# ============================================
# Por defecto DESHABILITADO - Los reintentos son MANUALES
# Para habilitar reintentos automáticos cada 5 minutos, cambiar a 'true'
SUNAT_AUTO_RETRY_ENABLED=false

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_POS_ENABLED=true
FEATURE_RRHH_ENABLED=false
FEATURE_INVENTARIO_ENABLED=true

