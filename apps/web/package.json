{
  "name": "@erp-suite/web",
  "version": "1.0.0",
  "description": "Frontend Next.js 15 para ERP Suite",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:tauri": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "desktop:dev": "pnpm run tauri:dev",
    "desktop:build": "pnpm run tauri:build",
    "tauri": "tauri dev",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "playwright test tests/e2e/setup.spec.ts tests/e2e/middleware-auth.spec.ts tests/e2e/inventario-maestros-460.spec.ts tests/e2e/referenced-note-fiscal-gate.spec.ts tests/e2e/qa-finance-kardex-496.spec.ts tests/e2e/contabilidad-monitoreo-outbox-492.spec.ts --reporter=line && playwright test tests/e2e/theme-contract.spec.ts --grep \"login público\" --reporter=line",
    "test:e2e:dev": "node scripts/run-dev-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:offline": "node tests/offline/verify-offline-store.mjs",
    "test:onboarding": "node tests/onboarding/verify-tour-anchors.mjs && node tests/onboarding/verify-module-guides.mjs",
    "test:pos-idempotencia": "node tests/pos/verify-pos-idempotencia.mjs",
    "test:pos-offline": "node tests/pos/verify-offline-abort.mjs",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.90.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.294.0",
    "next": "^15.5.21",
    "postcss": "^8.5.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^3.3.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@supabase/supabase-js": "^2.39.0",
    "@tauri-apps/api": "^2.6.2",
    "@tauri-apps/cli": "^2.6.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.4.5"
  }
}
