# ==========================================================================
# ERP Suite - Variables de entorno para docker-compose local
# Copie este archivo como .env y reemplace todos los valores por secretos reales.
# No use estos placeholders en produccion.
# ==========================================================================

# Limite de entorno (reemplazar project ref y URLs en conjunto)
DEPLOYMENT_ENV=DEV
EXPECTED_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
DEMO_API_ENABLED=false

# Supabase
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key_min_32_chars
SUPABASE_SERVICE_ROLE_KEY=Replace_with_Service_Role_Key_123456789!
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key_min_32_chars

# API auth/security
JWT_SECRET=Replace_with_JWT_Secret_123456789!
JWT_REFRESH_SECRET=replace_with_refresh_secret_min_32_chars
SESSION_SECRET=replace_with_session_secret_min_32_chars
CSRF_SECRET=replace_with_csrf_secret_min_32_chars
AUTH_SIGNATURE_SECRET=Replace_with_Auth_Signature_123456789!
ENCRYPTION_KEY=replace_with_encryption_key_min_32_chars
DB_ENCRYPTION_KEY=replace_with_db_encryption_key_min_32_chars
CERT_ENCRYPTION_KEY=replace_with_cert_encryption_key_min_32_chars
HEALTH_TOKEN=replace_with_health_token
METRICS_TOKEN=

# Certificados/OSE/SUNAT
PFX_PASS=replace_with_pfx_password
SUNAT_ENVIRONMENT=homologacion
SUNAT_CPE_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_GRE_URL=https://e-beta.sunat.gob.pe/ol-ti-itemision-guia-gem-beta/billService
SUNAT_GRE_TRANSPORT=soap
SUNAT_GRE_REST_BASE_URL=https://api-cpe.sunat.gob.pe/v1
SUNAT_GRE_AUTH_URL=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=
SUNAT_SUMMARY_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_QUERY_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
OSE_URL=
OSE_USERNAME=replace_with_ose_username
OSE_PASSWORD=replace_with_ose_password

# Worker
POS_WORKER_JWT_SECRET=replace_with_worker_jwt_secret_min_24_chars
WORKER_API_JWT_SECRET=replace_with_worker_api_secret_min_24_chars
REDIS_PASSWORD=replace_with_redis_password
REDIS_REQUIRED=true

# Frontend/API
WEB_HOST_PORT=13001
API_HOST_PORT=13002
WORKER_HOST_PORT=3050
REDIS_HOST_PORT=6381
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password
REDIS_EXPORTER_HOST_PORT=9122
NODE_EXPORTER_HOST_PORT=9101
NEXT_PUBLIC_API_URL=http://localhost:13002
ALLOWED_ORIGINS=http://localhost:13001

# Feature flags
FEATURE_POS_ENABLED=true
FEATURE_RRHH_ENABLED=true
FEATURE_INVENTARIO_ENABLED=true
NEXT_PUBLIC_FEATURE_POS_ENABLED=true
NEXT_PUBLIC_FEATURE_RRHH_ENABLED=true
NEXT_PUBLIC_FEATURE_INVENTARIO_ENABLED=true
